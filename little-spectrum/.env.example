# Copy this file to .env.local and fill in values from your Supabase project
# (Project settings -> API keys). Without these, the app runs in demo mode.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). The legacy "service_role" key also works.
# Server only. Never expose this to the browser or commit it.
SUPABASE_SECRET_KEY=

# Public URL of the deployed site, used for invitation links.
# Vercel sets VERCEL_URL automatically, so this is optional there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
